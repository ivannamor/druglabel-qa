# Copy to .env and fill in. Never commit .env.
# Only the credentials of the providers you select need a value.

# --- LLM (generation + KG extraction) ---
LLM_PROVIDER=openai                # openai | azure_openai | anthropic | gemini
LLM_MODEL=gpt-5.4-mini-2026-03-17  # Azure: deployment name; others: model name (prefer dated snapshots)
LLM_FALLBACK_MODEL=                 # optional; empty = none (one model per run keeps configs comparable)
LLM_TEMPERATURE=0.0
LLM_MIN_INTERVAL_S=1.5             # spacing between API calls (stay under requests per minute)
ANSWER_PROMPT=answer_v1            # prompts/answer_v1.md

# --- LLM-as-judge ---
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-5-5
JUDGE_FALLBACK_MODEL=              # optional; must not be the generator model

# --- Embeddings ---
EMBEDDING_PROVIDER=local           # local | azure_openai | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Credentials ---
GEMINI_API_KEY=                    # optional; from aistudio.google.com
AZURE_OPENAI_ENDPOINT=             # https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Data ---
OPENFDA_API_KEY=                   # optional

# --- Databricks (Gold snapshot download, MLflow tracking) ---
DATABRICKS_HOST=                   # https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=                  # Settings → Developer → Access tokens
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=druglabel_qa
GOLD_VERSION=0                     # Delta version of gold_embeddings to use
LABEL_METADATA_VERSION=0           # Delta version of label_metadata to use
MLFLOW_EXPERIMENT=                 # optional; default /Users/<you>/druglabel-qa/druglabel-qa-runs

# --- Tracing (Langfuse Cloud; Settings -> API keys in your Langfuse project) ---
LANGFUSE_PUBLIC_KEY=               # pk-lf-...
LANGFUSE_SECRET_KEY=               # sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # EU region; US: https://us.cloud.langfuse.com

# --- Knowledge graph (Neo4j AuraDB Free; values from the credentials file shown at instance creation) ---
NEO4J_URI=                         # neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Retrieval ---
RETRIEVAL_MODE=vector              # vector | graph | hybrid
TOP_K=5
GRAPH_MAX_PASSAGES=8               # passages from graph edges (graph and hybrid modes)
DEDUP_THRESHOLD=0.95               # near-duplicate passages of the same drug and section collapse into one
