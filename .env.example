# Copy to .env and fill in. Never commit .env.
# Only the credentials of the providers you select need a value.

# --- LLM (generation + KG extraction) ---
LLM_PROVIDER=gemini                # gemini | azure_openai | openai | anthropic
LLM_MODEL=gemma-4-31b-it           # Azure: deployment name; others: model name
LLM_TEMPERATURE=0.0

# --- LLM-as-judge ---
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash-lite
JUDGE_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- Embeddings ---
EMBEDDING_PROVIDER=local           # local | azure_openai | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Credentials ---
GEMINI_API_KEY=                    # from aistudio.google.com
AZURE_OPENAI_ENDPOINT=             # https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Data ---
OPENFDA_API_KEY=                   # optional

# --- Databricks (Gold snapshot download, MLflow tracking) ---
DATABRICKS_HOST=                   # https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=                  # Settings → Developer → Access tokens
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=druglabel_qa
GOLD_VERSION=0                     # Delta version of gold_embeddings to use

# --- Retrieval ---
RETRIEVAL_MODE=vector              # vector | graph | hybrid
TOP_K=5
DEDUP_THRESHOLD=0.95               # near-duplicate passages of the same drug and section collapse into one
