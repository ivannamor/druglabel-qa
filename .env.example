# Copy to .env and fill in. Never commit .env.
# Only the credentials of the providers you select need a value.

# --- LLM (generation + KG extraction) ---
LLM_PROVIDER=github_models         # github_models | gemini | azure_openai | openai | anthropic
LLM_MODEL=openai/gpt-4.1-mini      # Azure: deployment name; GitHub Models: publisher/model
LLM_TEMPERATURE=0.0

# --- LLM-as-judge (use a different model family than the generator) ---
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash

# --- Embeddings ---
EMBEDDING_PROVIDER=local           # local | azure_openai | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Credentials ---
GITHUB_TOKEN=                      # fine-grained PAT with "Models: read"
GEMINI_API_KEY=                    # from aistudio.google.com
AZURE_OPENAI_ENDPOINT=             # https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Data ---
OPENFDA_API_KEY=                   # optional

# --- Retrieval ---
RETRIEVAL_MODE=vector              # vector | graph | hybrid
TOP_K=5
